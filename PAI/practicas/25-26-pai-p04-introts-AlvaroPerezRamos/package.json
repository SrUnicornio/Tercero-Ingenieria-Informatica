{
  "name": "Práctica 4 de PAI",
  "version": "1.0.0",
  "description": "Introducción a TS. Documentación con TypeDoc",
  "private": true,
  "main": "index.js",
  "scripts": {
    "push": "rm *~; git pull; git add . ; git commit -m 'Code improvement'; git push",
    "pull": "git pull",
    "test": "jest",
    "lint:ci": "eslint . --ext .tsx,.ts",
    "start": "tsc-watch --onSuccess \"node dist/index.js\"",
    "docs": "typedoc --tsconfig tsconfig.json --out docs src/index.ts"
  },
  "keywords": [
    "PAI"
  ],
  "author": "Alvaro Pérez Ramos <alvaro.perez.ramos23@ull.es>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@exercism/babel-preset-typescript": "^0.1.0",
    "@types/node": "^18.19.130",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "babel-jest": "^27.5.1",
    "core-js": "^3.21.0",
    "eslint": "^8.57.1",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-n": "^15.6.1",
    "eslint-plugin-promise": "^6.1.1",
    "globals": "^17.3.0",
    "http-server": "^14.1.1",
    "jest": "^29.4.3",
    "tsc-watch": "^6.0.0",
    "typedoc": "^0.23.28",
    "typescript": "^4.9.5",
    "typescript-eslint": "^8.56.1"
  }
}
