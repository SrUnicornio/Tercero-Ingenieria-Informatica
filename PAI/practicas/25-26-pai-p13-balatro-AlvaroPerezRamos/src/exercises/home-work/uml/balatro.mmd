classDiagram
  direction TB

  %% ── Observer ─────────────────────────────────────────────────────────────
  class Event~PayloadType~ {
    -listeners: Listener~PayloadType~[]
    +addListener(listener) void
    +removeAllListeners() void
    +trigger(data: PayloadType) void
  }

  %% ── Tipos compartidos ────────────────────────────────────────────────────
  class HandResult {
    <<interface>>
    +handName: string
    +chips: number
    +multiplier: number
    +scoringCards: readonly Card[]
  }
  class GameStartedData {
    <<interface>>
    +hand: readonly Card[]
    +deckRemaining: number
  }
  class CardToggledData {
    <<interface>>
    +cardIndex: number
    +isSelected: boolean
  }
  class HandPlayedData {
    <<interface>>
    +handResult: HandResult
    +roundScore: number
    +totalScore: number
    +handsLeft: number
    +deckRemaining: number
    +hand: readonly Card[]
  }
  class CardsDiscardedData {
    <<interface>>
    +replacementCards: readonly Card[]
    +replacedIndices: readonly number[]
    +deckRemaining: number
    +discardsLeft: number
    +hand: readonly Card[]
  }
  class ScorePreviewData {
    <<interface>>
    +handResult: HandResult | null
    +cardBonusChips: number
  }
  class GameEndedData {
    <<interface>>
    +playerWon: boolean
    +finalScore: number
  }
  class GameEventChannels {
    <<interface>>
    +triggerGameStarted(data) void
    +triggerCardToggled(data) void
    +triggerHandPlayed(data) void
    +triggerCardsDiscarded(data) void
    +triggerScorePreview(data) void
    +triggerGameEnded(data) void
  }
  class ScoreDisplayElements {
    <<interface>>
    +deckRemaining: HTMLElement
    +scoreTotal: HTMLElement
    +progressFill: HTMLElement
    +progressText: HTMLElement
  }
  class PreviewDisplayElements {
    <<interface>>
    +handSizeIndicator: HTMLElement
    +handName: HTMLElement
    +chips: HTMLElement
    +multiplier: HTMLElement
    +total: HTMLElement
  }

  %% ── Modelo: entidades ────────────────────────────────────────────────────
  class Card {
    -rankValue: number
    -suitValue: Suit
    -labelValue: RankLabel
    -imagePathValue: string
    +getRank() number
    +getSuit() Suit
    +getLabel() RankLabel
    +getImagePath() string
    +toString() string
  }
  class Deck {
    -cards: Card[]
    -dealIndex: number
    +remainingCount() number
    +deal(count: number) Card[]
    -buildDeck() Card[]
    -shuffle() void
  }

  %% ── Modelo: evaluación de póker ──────────────────────────────────────────
  class HandDetectors {
    <<module>>
    +hasNOfAKind(cards, n) boolean
    +hasTwoPair(cards) boolean
    +hasFullHouse(cards) boolean
    +hasFlush(cards) boolean
    +hasStraight(cards) boolean
    +buildRankFrequencyMap(cards) Map
  }
  class HandExtractors {
    <<module>>
    +extractNOfAKind(cards, n) Card[]
    +extractTwoPair(cards) Card[]
    +extractAllCards(cards) Card[]
    +extractHighCard(cards) Card[]
  }
  class HandTableEntry {
    <<interface>>
    +name: string
    +chips: number
    +multiplier: number
  }
  class HandTable {
    <<module>>
    +getHandTable() readonly HandTableEntry[]
    +HAND_DEFINITIONS: readonly HandDefinition[]
    +HIGH_CARD_BASE_CHIPS: number
    +HIGH_CARD_BASE_MULTIPLIER: number
  }
  class HandCalculator {
    <<module>>
    +calculateCardChips(scoringCards) number
  }
  class HandEvaluator {
    +evaluate(cards)$ HandResult
  }

  %% ── Modelo: gestión de partida ───────────────────────────────────────────
  class RoundManager {
    -totalScore: number
    -handsLeft: number
    -discardsLeft: number
    +reset() void
    +registerHandScore(score) number
    +useDiscard() void
    +getScore() number
    +getHandsRemaining() number
    +getDiscardsRemaining() number
    +getScoreGoal() number
    +getIsVictory() boolean
    +getIsDefeated() boolean
  }
  class HandManager {
    -currentHand: Card[]
    -selectedIndices: Set~number~
    -cardToggledEvent: Event~CardToggledData~
    -scorePreviewEvent: Event~ScorePreviewData~
    +onCardToggled(listener) void
    +onScorePreview(listener) void
    +dealInitialHand(count) void
    +toggleCard(cardIndex) void
    +discardSelected() object
    +clearSelection() void
    +sortHand(criterion) void
    +getHand() readonly Card[]
    +getSelectedCardIndices() ReadonlySet~number~
    +getSelectedCards() Card[]
    -emitScorePreview() void
  }
  class GameEventPublisher {
    -gameStartedChannel: Event~GameStartedData~
    -cardToggledChannel: Event~CardToggledData~
    -handPlayedChannel: Event~HandPlayedData~
    -cardsDiscardedChannel: Event~CardsDiscardedData~
    -scorePreviewChannel: Event~ScorePreviewData~
    -gameEndedChannel: Event~GameEndedData~
    +onGameStarted(listener) void
    +onCardToggled(listener) void
    +onHandPlayed(listener) void
    +onCardsDiscarded(listener) void
    +onScorePreview(listener) void
    +onGameEnded(listener) void
    +channels() GameEventChannels
  }
  class GameActions {
    -deck: Deck
    -handManager: HandManager
    -roundManager: RoundManager
    -channels: GameEventChannels
    +startGame() void
    +toggleCard(cardIndex) void
    +playHand() boolean
    +discard() boolean
    +sortHand(criterion) void
    +getHandsRemaining() number
    +getDiscardsRemaining() number
    +getScoreGoal() number
    +getScore() number
    +getHand() readonly Card[]
    +getSelectedCardIndices() ReadonlySet~number~
    +isVictory() boolean
    +isDefeated() boolean
    +getFinalScore() number
    -wireHandManagerEvents() void
  }
  class BalatroModel {
    <<facade>>
    -publisher: GameEventPublisher
    -actions: GameActions
    -isGameOver: boolean
    +onGameStarted(listener) void
    +onCardToggled(listener) void
    +onHandPlayed(listener) void
    +onCardsDiscarded(listener) void
    +onScorePreview(listener) void
    +onGameEnded(listener) void
    +startGame() void
    +toggleCard(cardIndex) void
    +playHand() void
    +discard() void
    +sortHand(criterion) void
    +getHandsRemaining() number
    +getDiscardsRemaining() number
    +getScoreGoal() number
    +getScore() number
    +getHand() readonly Card[]
    +getSelectedCardIndices() ReadonlySet~number~
    +getInitialHands() number
    +getInitialDiscards() number
    +getMaxHandSize() number
    -checkEndCondition() void
  }

  %% ── Vista ────────────────────────────────────────────────────────────────
  class HandAreaView {
    -container: HTMLElement
    -cardSlots: HTMLDivElement[]
    -cardClickedEvent: Event~number~
    +onCardClicked(listener) void
    +renderHand(cards) void
    +setCardSelected(index, isSelected) void
    -buildCardSlot(card, index) HTMLDivElement
  }
  class ScorePanelView {
    -scoreElements: ScoreDisplayElements
    -previewElements: PreviewDisplayElements
    +updateDeckRemaining(remaining) void
    +updateTotalScore(total) void
    +updateHandSizeIndicator(currentSize, maxSize) void
    +updateScorePreview(handResult, cardBonusChips) void
  }
  class ControlsView {
    -playHandButton: HTMLButtonElement
    -discardButton: HTMLButtonElement
    -newGameButton: HTMLButtonElement
    -infoButton: HTMLButtonElement
    -sortHandButton: HTMLButtonElement
    -handsLeftDisplay: HTMLElement
    -discardsLeftDisplay: HTMLElement
    -gameResultModal: HTMLDialogElement
    -gameResultMessage: HTMLElement
    -playHandEvent: Event~void~
    -discardEvent: Event~void~
    -newGameEvent: Event~void~
    -infoButtonEvent: Event~void~
    -sortHandEvent: Event~criterion~
    -currentSortCriterion: rank|suit
    +onHandInfo(listener) void
    +onPlayHand(listener) void
    +onDiscard(listener) void
    +onNewGame(listener) void
    +onSortHand(listener) void
    +updateButtonStates(hasSelection, handsLeft, discardsLeft, isGameOver) void
    +updateCounters(handsLeft, discardsLeft) void
    +showGameResult(playerWon, finalScore) void
    +resetForNewGame() void
  }
  class HandInfoView {
    -modal: HTMLDialogElement
    +open() void
    -buildHandTable() void
    -buildHandRow(name, chips, multiplier) string
    -wireCloseEvents() void
  }
  class ViewInputRouter {
    -handArea: HandAreaView
    -controls: ControlsView
    +onCardClicked(listener) void
    +onPlayHand(listener) void
    +onDiscard(listener) void
    +onNewGame(listener) void
    +onSortHand(listener) void
    +onHandInfo(listener) void
  }
  class ViewRenderer {
    -handArea: HandAreaView
    -scorePanel: ScorePanelView
    -controls: ControlsView
    +onGameStarted(data, initialHands, initialDiscards) void
    +onCardToggled(data, handsLeft, discardsLeft, selectionSize, maxHands) void
    +onHandPlayed(data) void
    +onHandSorted(hand, selectedIndices, handsLeft, discardsLeft) void
    +onCardsDiscarded(data) void
    +onScorePreview(data) void
    +onGameEnded(data, maxHands) void
  }
  class BalatroView {
    <<facade>>
    +inputs: ViewInputRouter
    +renderer: ViewRenderer
    +handInfo: HandInfoView
    -getElement(id) HTMLElement
  }

  %% ── Controlador ──────────────────────────────────────────────────────────
  class BalatroController {
    -model: BalatroModel
    -view: BalatroView
    +run() void
    -wireModelToView() void
    -wireViewToModel() void
  }

  class BalatroClient {
    <<module>>
    +main() void
  }

  %% ── Relaciones: Cliente ───────────────────────────────────────────────────
  BalatroClient --> BalatroModel
  BalatroClient --> BalatroView
  BalatroClient --> BalatroController

  %% ── Relaciones: Modelo ───────────────────────────────────────────────────
  Deck "1" *-- "52" Card
  HandManager --> Deck : usa
  HandManager --> HandEvaluator : evalúa selección
  HandManager --> HandCalculator : calcula chips
  HandEvaluator --> HandDetectors : delega detección
  HandEvaluator --> HandExtractors : delega extracción
  HandEvaluator --> HandTable : importa definiciones
  HandEvaluator ..> HandResult : retorna
  HandTable ..> HandTableEntry : expone
  GameActions *-- Deck
  GameActions *-- HandManager
  GameActions *-- RoundManager
  GameActions --> HandCalculator : calcula chips
  GameActions --> GameEventChannels : emite a través de
  GameEventPublisher ..|> GameEventChannels : implementa
  GameEventPublisher *-- "6" Event~PayloadType~
  HandManager *-- Event~CardToggledData~
  HandManager *-- Event~ScorePreviewData~
  BalatroModel *-- GameEventPublisher
  BalatroModel *-- GameActions

  %% ── Relaciones: Vista ────────────────────────────────────────────────────
  ScorePanelView --> ScoreDisplayElements : usa
  ScorePanelView --> PreviewDisplayElements : usa
  HandInfoView --> HandTable : importa getHandTable
  HandAreaView *-- Event~number~
  ControlsView *-- "5" Event~PayloadType~
  ViewInputRouter --> HandAreaView : delega inputs
  ViewInputRouter --> ControlsView : delega inputs
  ViewRenderer --> HandAreaView : actualiza
  ViewRenderer --> ScorePanelView : actualiza
  ViewRenderer --> ControlsView : actualiza
  BalatroView *-- ViewInputRouter
  BalatroView *-- ViewRenderer
  BalatroView *-- HandInfoView
  BalatroView *-- HandAreaView
  BalatroView *-- ScorePanelView
  BalatroView *-- ControlsView

  %% ── Relaciones: Controlador ──────────────────────────────────────────────
  BalatroController o--> BalatroModel : coordina
  BalatroController o--> BalatroView : coordina