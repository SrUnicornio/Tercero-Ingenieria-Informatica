{
  "display": "Configuración para Programación Gráfica en PAI",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "rootDir": "src",
    "outDir": "./dist",
    "declarationDir": "./dist/types",
    "declaration": true,
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "alwaysStrict": true,
    "noImplicitAny": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "public",
    "node_modules",
    "dist",
    "jest.config.ts",
    "src/**/*.test.ts"
  ]
}