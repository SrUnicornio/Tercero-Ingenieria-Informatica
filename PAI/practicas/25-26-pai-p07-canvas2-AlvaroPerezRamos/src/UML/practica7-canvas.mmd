classDiagram
  direction TB

  %% =====================
  %% ENTRY POINT (APP CLIENT)
  %% =====================
  class ShapeClient {
    -btnDraw: HTMLButtonElement
    -btnClear: HTMLButtonElement
    -btnRandom: HTMLButtonElement
    +constructor(canvas, scene, form, controller, storage)
    -initialize() void
    -handleManualDraw() void
    -handleRandomDraw() void
    -displayClearAlert() void
    -saveScene() void
    -loadScene() void
  }

  %% =====================
  %% CORE DEPENDENCIES
  %% =====================
  class ShapeController {
    +drawShape(data) void
    +drawRandom(count) void
    +loadShapes(data) void
  }

  class ShapeScene {
    +getShapes() Shape[]
    +getShapeData() ShapeInputData[]
    +clear() void
    +redraw() void
  }

  class ShapeForm {
    +setPosition(x, y) void
    +getValues() ShapeInputData
  }

  class ShapeStorage {
    +save(data) void
    +load() ShapeInputData[]
  }

  class CanvasManager {
    +resize() void
    +onClick(callback) void
  }

  %% =====================
  %% STATIC UTILITIES
  %% =====================
  class ShapeStatistics {
    <<static>>
    +countByType(shapes) Map
  }

  %% =====================
  %% RELATIONSHIPS
  %% =====================
  
  %% El cliente agrega todos los componentes core para funcionar
  ShapeClient *-- CanvasManager : manages
  ShapeClient *-- ShapeScene : updates
  ShapeClient *-- ShapeForm : interacts
  ShapeClient *-- ShapeController : executes logic
  ShapeClient *-- ShapeStorage : persists data

  %% Relación de uso puntual para las alertas
  ShapeClient ..> ShapeStatistics : uses for alerts

  %% =====================
  %% CONTROLLERS & STORAGE
  %% =====================

  class ShapeController {
    +drawShape(data: ShapeInputData) void
    +drawRandom(count: number) void
    +loadShapes(data: ShapeInputData[]) void
  }

  class ShapeStorage {
    -key: string
    +save(data: ShapeInputData[]) void
    +load() ShapeInputData[]
    +clear() void
  }

  %% =====================
  %% MANAGERS & FORMS
  %% =====================

  class ShapeScene {
    -shapes: Shape[]
    -shapeData: ShapeInputData[]
    -context: CanvasRenderingContext2D
    +getShapes() Shape[]
    +getShapeData() ShapeInputData[]
    +add(shape, data) void
    +clear() void
    +redraw() void
  }

  class CanvasManager {
    -canvas: HTMLCanvasElement
    +getContext() CanvasRenderingContext2D
    +getWidth() number
    +getHeight() number
    +resize() void
    +onClick(callback) void
  }

  class ShapeForm {
    -shapeSelect: HTMLSelectElement
    -inputColor: HTMLInputElement
    -paramInputs: Map
    +setPosition(x, y) void
    +setValues(data) void
    +getValues() ShapeInputData
    -updateInputs() void
    -buildShapeOptions() void
  }

  %% =====================
  %% UTILITIES & LOGIC
  %% =====================

  class RandomShapeGenerator {
    <<static>>
    +generate(width, height) ShapeInputData
  }

  class ShapeValidator {
    <<static>>
    +clampCoordinates(values, width, height) ShapeInputData
  }

  class ShapeStatistics {
    <<static>>
    +countByType(shapes: Shape[]) Map
  }

  %% =====================
  %% DATA & EXTERNAL (Bottom)
  %% =====================
  class ShapeInputData {
    <<interface>>
  }

  class Shape {
    <<abstract>>
  }

  class ShapeFactory {
    <<static>>
  }

  %% =====================
  %% RELATIONSHIPS
  %% =====================

  %% Orchestration
  ShapeController --> ShapeScene : manages
  ShapeController --> CanvasManager : uses
  ShapeStorage ..> ShapeInputData : persists

  %% Input Flow
  ShapeForm ..> ShapeInputData : produces
  RandomShapeGenerator ..> ShapeInputData : produces
  ShapeValidator ..> ShapeInputData : validates

  %% Execution Flow
  ShapeScene o-- Shape : contains
  ShapeScene o-- ShapeInputData : stores
  ShapeStatistics ..> Shape : analyzes

  %% System Dependencies
  ShapeForm ..> ShapeFactory : queries
  ShapeController ..> ShapeFactory : invokes

  %% =====================
  %% INPUT DATA STRUCTURES
  %% =====================

  class ShapeInputData {
    <<interface>>
    +type: string
    +coordinates: Coordinates
    +rotation: number
    +color: string
    +params: Record~string, number~
  }

  class ShapeRegistration {
    <<interface>>
    +constructor: ShapeConstructor
    +params: string[]
  }

  %% =====================
  %% FACTORY ENGINE
  %% =====================

  class ShapeFactory {
    -static registry: Map~string, ShapeRegistration~
    +static register(type, params, constructor) void
    +static createShape(data: ShapeInputData) Shape
    +static getRegisteredTypes() string[]
    +static getParams(type) string[]
  }

  %% =====================
  %% EXTERNAL REFERENCES
  %% =====================

  class Shape {
    <<abstract>>
  }

  class Coordinates {
    <<interface>>
  }

  %% =====================
  %% RELATIONSHIPS
  %% =====================

  ShapeFactory ..> Shape : creates
  ShapeRegistration "0..*" --* "1" ShapeFactory : manages
  ShapeInputData <.. ShapeFactory : processes

  ShapeRegistration --> ShapeInputData : uses in constructor
  Coordinates <-- ShapeInputData : contains

  %% =====================
  %% INTERFACES
  %% =====================
  class Coordinates {
    <<interface>>
    +x: number
    +y: number
  }

  %% =====================
  %% BASE CLASS
  %% =====================
  class Shape {
    <<abstract>>
    #coordinates: Coordinates
    #color: string
    #rotation: number
    +getCoordinates() Coordinates
    +getColor() string
    +getRotation() number
    +getType() string
    +draw(context: CanvasRenderingContext2D) void
    +computeArea()* number
    #drawShape(context: CanvasRenderingContext2D)* void
  }

  Coordinates --o Shape : uses

  %% =====================
  %% SHAPE IMPLEMENTATIONS
  %% =====================

  class Circle {
    -radius: number
    +computeArea() number
    #drawShape(context: CanvasRenderingContext2D) void
  }

  class Rectangle {
    #width: number
    #height: number
    +computeArea() number
    #drawShape(context: CanvasRenderingContext2D) void
  }

  class Triangle {
    -base: number
    -height: number
    +computeArea() number
    #drawShape(context: CanvasRenderingContext2D) void
  }

  class Polygon {
    -sides: number
    -radius: number
    +getType() string
    +computeArea() number
    #drawShape(context: CanvasRenderingContext2D) void
  }

  class Star {
    -points: number
    -outerRadius: number
    -innerRadius: number
    +getType() string
    +computeArea() number
    #drawShape(context: CanvasRenderingContext2D) void
  }

  class Cross {
    -size: number
    +computeArea() number
    #drawShape(context: CanvasRenderingContext2D) void
  }

  class Oval {
    -radiusX: number
    -radiusY: number
    +getRadiusX() number
    +getRadiusY() number
    +computeArea() number
    #drawShape(context: CanvasRenderingContext2D) void
  }

  class Heart {
    -size: number
    +computeArea() number
    #drawShape(context: CanvasRenderingContext2D) void
  }

  class Trapezoid {
    -topBase: number
    -bottomBase: number
    -height: number
    +computeArea() number
    #drawShape(context: CanvasRenderingContext2D) void
  }

  class Arrow {
    -length: number
    -headSize: number
    +computeArea() number
    #drawShape(context: CanvasRenderingContext2D) void
  }

  class Clover {
    -size: number
    +computeArea() number
    #drawShape(context: CanvasRenderingContext2D) void
  }

  %% =====================
  %% SPECIALIZATIONS
  %% =====================

  class Square {
    +side: number
  }

  class Diamond {
    #drawShape(context: CanvasRenderingContext2D) void
  }

  %% =====================
  %% RELATIONSHIPS
  %% =====================

  Shape <|-- Circle
  Shape <|-- Rectangle
  Shape <|-- Triangle
  Shape <|-- Polygon
  Shape <|-- Star
  Shape <|-- Cross
  Shape <|-- Oval
  Shape <|-- Heart
  Shape <|-- Trapezoid
  Shape <|-- Arrow
  Shape <|-- Clover

  Rectangle <|-- Square
  Rectangle <|-- Diamond